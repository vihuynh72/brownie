# The single public origin. Everything a browser talks to arrives here: the
# application's own files, the API under /api, and the three sign-in paths the
# identity provider and the browser use.
#
# ${BROWNIE_SERVER_NAME} is the address the certificate was issued for.
# ${BROWNIE_API_HOST} is the API's name on the private network between the
# containers; it is not reachable from outside this machine.

# The API's own routes are logged by path alone. When an identity provider
# sends a browser back, the address carries a code that can still be
# exchanged for access, and its state, in the query string: the sign-in
# callback does, and so does the one for connecting a Google account.
# Nothing else in a query string there is worth keeping in a log either.
log_format brownie_path_only '$remote_addr - [$time_local] "$request_method $uri $server_protocol" $status $body_bytes_sent';

server {
    listen 80;
    listen [::]:80;
    server_name ${BROWNIE_SERVER_NAME};

    # The only thing plain HTTP is allowed to answer: the challenge a
    # certificate authority reads to prove this machine owns the name.
    location /.well-known/acme-challenge/ {
        root /var/www/acme;
    }

    # Something for this machine to ask this container, to know it is serving
    # rather than merely running. It has to be here, on plain HTTP, because
    # everything else on this port redirects and the check would follow the
    # redirect to a name that does not resolve inside the container. It says
    # nothing that the redirect above does not already reveal.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        # The configured name, not the one the caller asked for: this is the
        # only server block, so a request carrying any other name still
        # arrives here, and echoing it back would turn this into a redirect
        # to wherever the caller chose.
        return 308 https://${BROWNIE_SERVER_NAME}$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${BROWNIE_SERVER_NAME};

    ssl_certificate     /etc/brownie/tls/fullchain.pem;
    ssl_certificate_key /etc/brownie/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache shared:BrownieTLS:10m;
    ssl_session_tickets off;

    include /etc/nginx/brownie-security-headers.conf;

    # A file larger than the application accepts is refused here rather than
    # after it has been carried all the way to the API.
    client_max_body_size 12m;

    location /.well-known/acme-challenge/ {
        root /var/www/acme;
    }

    # Everything the API owns. The scheme and host below are what let it build
    # the sign-in callback and its cookies for the address the browser
    # actually used, rather than for the container's own name.
    location ~ ^/(api|oauth2|login|logout)(/|$) {
        access_log /var/log/nginx/access.log brownie_path_only;
        proxy_pass http://${BROWNIE_API_HOST}:8081;
        proxy_http_version 1.1;
        # Every one of these is set from what this server knows, never from
        # what the caller sent. The API trusts them -- that is the point of
        # forwarding them -- so a caller able to choose them could make the
        # application build its sign-in callback for another name, and could
        # give itself a fresh request allowance on every request by inventing
        # a new address. The usual $proxy_add_x_forwarded_for appends the real
        # caller to a list the caller itself started, and the value the
        # application reads is the first in that list, so it would be the
        # caller's invention; $remote_addr alone is the one address this
        # machine actually observed. $host is the name the caller asked for,
        # which is not necessarily this one, so the canonical name is used
        # instead of it.
        proxy_set_header Host ${BROWNIE_SERVER_NAME};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host ${BROWNIE_SERVER_NAME};
        proxy_set_header X-Forwarded-Port $server_port;
        # Progress arrives as a stream of events that must not be held back
        # until a buffer fills, and a generation can take longer than the
        # default minute before its first byte.
        proxy_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # The application's own files. A build gives every asset a content hash in
    # its name, so those can be kept for a year; the page that names them must
    # never be, or a browser would keep loading the previous release.
    location /assets/ {
        root /usr/share/nginx/html;
        include /etc/nginx/brownie-security-headers.conf;
        expires 1y;
        add_header Cache-Control "public, immutable" always;
        access_log off;
    }

    location / {
        root /usr/share/nginx/html;
        try_files $uri $uri/ /index.html;
        include /etc/nginx/brownie-security-headers.conf;
        add_header Cache-Control "no-cache" always;
    }
}
