# Example only. Keep real (non-local) values in an ignored local .env file
# or a local secret manager -- never commit them.
#
# The values below are not secrets: they are the fixed, local-only
# placeholders that infra/local/postgres/init/01-app-roles.sql creates,
# reachable only from this machine (infra/local/compose.yaml binds
# Postgres to 127.0.0.1). Copying this file as-is is enough to run
# brownie-api or brownie-worker locally against `docker compose up` in
# infra/local/ -- see README.md.

# Local profile
BROWNIE_ENVIRONMENT=local
BROWNIE_PUBLIC_ORIGIN=http://localhost:8081

# Runtime credential for this process only. Set BROWNIE_DB_USERNAME/
# PASSWORD to brownie_api when running brownie-api, brownie_worker when
# running brownie-worker -- same variable names, different values per
# process. Neither can create or alter tables.
BROWNIE_DB_URL=jdbc:postgresql://localhost:5432/brownie
BROWNIE_DB_USERNAME=brownie_api
BROWNIE_DB_PASSWORD=brownie_api_local_only

# brownie-api only: the elevated role Flyway uses to run migrations. Never
# used for ordinary application traffic, and brownie-worker never sees it.
BROWNIE_DB_MIGRATION_USERNAME=brownie_migration
BROWNIE_DB_MIGRATION_PASSWORD=brownie_migration_local_only

# brownie-api only: the owner's Entra External ID tenant and app
# registration. Unlike the Postgres values above, nothing here has a
# working local placeholder -- Docker cannot stand up a real identity
# provider. Leave these blank and brownie-api will fail to start on the
# local profile with a clear error, until the owner has created the
# tenant/registration and put the real values here.
BROWNIE_OIDC_ISSUER=
BROWNIE_OIDC_CLIENT_ID=
BROWNIE_OIDC_CLIENT_SECRET=

# Azurite's own fixed, publicly documented development account name/key --
# not a secret, and meaningless outside a local Azurite instance. Only
# valid on the local/test profiles; brownie-api refuses to start on
# pilot/production if this is set at all (see BlobStorageConfig). Matches
# infra/local/compose.yaml's azurite service.
BROWNIE_LOCAL_STORAGE_CONNECTION="DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;"

# Maximum bytes accepted for a single artifact upload (10 MiB).
BROWNIE_MAX_UPLOAD_BYTES=10485760

# The clamd instance every uploaded artifact is scanned against before it
# can reach READY. Matches infra/local/compose.yaml's clamav service; not
# a secret, just a network endpoint (unlike BROWNIE_LOCAL_STORAGE_CONNECTION,
# there is nothing local-dev-only about this shape of value -- a real
# deployment points these at a real clamd the same way).
BROWNIE_CLAMAV_HOST=127.0.0.1
BROWNIE_CLAMAV_PORT=3310

# brownie-api only: the project-scoped OpenAI API key for the model
# gateway. Unlike everything above, there is no working local placeholder
# -- Docker cannot stand up a real model provider. Leave this blank and
# brownie-api will fail to start on the local profile with a clear error,
# until the owner has created the key and put the real value here. The
# model snapshot itself is not a secret and is not set here -- see
# BROWNIE_OPENAI_MODEL below for the (already-defaulted) exception.
BROWNIE_OPENAI_API_KEY=

# Optional, left unset here on purpose (a present-but-empty value would
# override the real default with an empty model name, the same
# BROWNIE_OIDC_ISSUER footgun documented above): uncomment only to test a
# specific alternative snapshot. application.yml already defaults this to
# the one evaluated baseline model, a deliberate architecture decision,
# not per-environment config.
# BROWNIE_OPENAI_MODEL=gpt-5.4-mini-2026-03-17
