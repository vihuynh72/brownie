# Example only. Keep real (non-local) values in an ignored local .env file
# or a local secret manager -- never commit them.
#
# The values below are not secrets: they are the fixed, local-only
# placeholders that infra/local/postgres/init/01-app-roles.sql creates,
# reachable only from this machine (infra/local/compose.yaml binds
# Postgres to 127.0.0.1). Copying this file as-is is enough to run
# brownie-api or brownie-worker locally against `docker compose up` in
# infra/local/ -- see README.md.

# Local profile
BROWNIE_ENVIRONMENT=local
BROWNIE_PUBLIC_ORIGIN=http://localhost:8081

# Runtime credential for this process only. Set BROWNIE_DB_USERNAME/
# PASSWORD to brownie_api when running brownie-api, brownie_worker when
# running brownie-worker -- same variable names, different values per
# process. Neither can create or alter tables.
BROWNIE_DB_URL=jdbc:postgresql://localhost:5432/brownie
BROWNIE_DB_USERNAME=brownie_api
BROWNIE_DB_PASSWORD=brownie_api_local_only

# brownie-api only: the elevated role Flyway uses to run migrations. Never
# used for ordinary application traffic, and brownie-worker never sees it.
BROWNIE_DB_MIGRATION_USERNAME=brownie_migration
BROWNIE_DB_MIGRATION_PASSWORD=brownie_migration_local_only

# brownie-api only: the owner's Entra External ID tenant and app
# registration (master plan §18.6). Unlike the Postgres values above,
# nothing here has a working local placeholder -- Docker cannot stand up a
# real identity provider. Leave these blank and brownie-api will fail to
# start on the local profile with a clear error, until the owner has
# created the tenant/registration and put the real values here.
BROWNIE_OIDC_ISSUER=
BROWNIE_OIDC_CLIENT_ID=
BROWNIE_OIDC_CLIENT_SECRET=
