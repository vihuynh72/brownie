# Example only. Brownie has no configuration consumer yet.
# Keep real values in an ignored local .env file or a local secret manager.

# Local profile
BROWNIE_ENVIRONMENT=local
BROWNIE_PUBLIC_ORIGIN=http://localhost:8081

# Runtime credential for this process only. brownie-api and brownie-worker
# each get their own values (brownie_api / brownie_worker) -- same variable
# names, different values per process. Neither can create or alter tables.
BROWNIE_DB_URL=
BROWNIE_DB_USERNAME=
BROWNIE_DB_PASSWORD=

# brownie-api only: the elevated role Flyway uses to run migrations. Never
# used for ordinary application traffic, and brownie-worker never sees it.
BROWNIE_DB_MIGRATION_USERNAME=
BROWNIE_DB_MIGRATION_PASSWORD=
