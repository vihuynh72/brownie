# Example only. Keep real (non-local) values in an ignored local .env file
# or a local secret manager -- never commit them.
#
# The values below are not secrets: they are the fixed, local-only
# placeholders that infra/local/postgres/init/01-app-roles.sql creates,
# reachable only from this machine (infra/local/compose.yaml binds
# Postgres to 127.0.0.1). Copying this file as-is is enough to run
# brownie-api or brownie-worker locally against `docker compose up` in
# infra/local/ -- see README.md.

# Local profile
BROWNIE_ENVIRONMENT=local
BROWNIE_PUBLIC_ORIGIN=http://localhost:8081

# Runtime credential for this process only. Set BROWNIE_DB_USERNAME/
# PASSWORD to brownie_api when running brownie-api, brownie_worker when
# running brownie-worker -- same variable names, different values per
# process. Neither can create or alter tables.
BROWNIE_DB_URL=jdbc:postgresql://localhost:5432/brownie
BROWNIE_DB_USERNAME=brownie_api
BROWNIE_DB_PASSWORD=brownie_api_local_only

# brownie-api only: the elevated role Flyway uses to run migrations. Never
# used for ordinary application traffic, and brownie-worker never sees it.
BROWNIE_DB_MIGRATION_USERNAME=brownie_migration
BROWNIE_DB_MIGRATION_PASSWORD=brownie_migration_local_only

# brownie-api only: the owner's Entra External ID tenant and app
# registration. Unlike the Postgres values above, nothing here has a
# working local placeholder -- Docker cannot stand up a real identity
# provider. Leave these blank and brownie-api will fail to start on the
# local profile with a clear error, until the owner has created the
# tenant/registration and put the real values here.
# The issuer must be the External ID tenant's OWN ciamlogin.com address,
# character for character as its discovery document states it:
#   https://<tenant-id>.ciamlogin.com/<tenant-id>/v2.0
# The same tenant also answers at
#   https://login.microsoftonline.com/<tenant-id>/v2.0
# but that address only signs in the tenant's admin and workforce
# accounts; a customer account sent there is refused with AADSTS500208
# and lands back here as a failed sign-in.
BROWNIE_OIDC_ISSUER=
BROWNIE_OIDC_CLIENT_ID=
BROWNIE_OIDC_CLIENT_SECRET=

# Optional. Where the browser is sent after a sign-in succeeds or fails.
# Defaults to BROWNIE_PUBLIC_ORIGIN, except on the local profile where it
# defaults to the Vite dev server (http://localhost:5173), because the
# identity provider's callback must still arrive at this API on 8081
# while the pages live on 5173. Scheme, host, and port only -- no path.
# BROWNIE_WEB_ORIGIN=http://localhost:5173

# Azurite's own fixed, publicly documented development account name/key --
# not a secret, and meaningless outside a local Azurite instance. Only
# valid on the local/test profiles; brownie-api refuses to start on
# pilot/production if this is set at all (see BlobStorageConfig). Matches
# infra/local/compose.yaml's azurite service.
BROWNIE_LOCAL_STORAGE_CONNECTION="DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;"

# Hosted deployments only, and the opposite of the line above: the two blob
# endpoints, reached with the identity the platform gave the process rather
# than with a key. Setting either of these on a local or test profile is
# refused at start-up, as is setting the connection string above on a hosted
# one -- one way in per environment, never two.
#
# They must be two different storage accounts. The second holds the record of
# what has been deleted, and it exists so that restoring the first cannot
# quietly bring back something a person asked to have removed; in one account
# a restore would roll the record back too. Start-up refuses them being equal.
# BROWNIE_STORAGE_ENDPOINT=https://<files-account>.blob.core.windows.net/
# BROWNIE_DELETION_RECORD_STORAGE_ENDPOINT=https://<record-account>.blob.core.windows.net/

# Maximum bytes accepted for a single artifact upload (10 MiB).
BROWNIE_MAX_UPLOAD_BYTES=10485760

# How many days a document stays in the trash before brownie-worker deletes
# it for good, with its files. Between 1 and 365; 30 when unset.
# BROWNIE_TRASH_RETENTION_DAYS=30

# The model allowance in US dollars, enforced before every request is sent.
# Give brownie-api and brownie-worker the same values. A run's limits count
# every attempt and resume of its job; the monthly limits are calendar
# months in UTC, one for each workspace and one for everyone together.
# BROWNIE_MODEL_RUN_MAX_REQUESTS=6
# BROWNIE_MODEL_RUN_USD_LIMIT=0.10
# BROWNIE_MODEL_WORKSPACE_MONTHLY_USD_LIMIT=2.00
# BROWNIE_MODEL_MONTHLY_USD_LIMIT=15.00

# How long leftovers are kept, as ISO-8601 durations. Give brownie-api and
# brownie-worker the same values: the worker acts on them and the API's
# "Your data" page tells people what they are.
# BROWNIE_RETENTION_ABANDONED_UPLOAD=PT24H
# BROWNIE_RETENTION_REFUSED_FILE=PT24H
# BROWNIE_RETENTION_UNUSED_FILE=PT24H
# BROWNIE_RETENTION_AUDIT_RECORD=P90D

# Who may sign in at all. The identity provider's own sign-up is open to
# anyone who reaches the address, which is right for a product and wrong for a
# pilot of about ten invited people. Off locally, on by default wherever this
# is deployed; whole addresses only, comma separated, never a domain. With the
# gate on and nobody listed, nobody signs in, including you.
# BROWNIE_INVITATIONS_REQUIRED=false
# BROWNIE_INVITED_ADDRESSES=someone@example.com,another@example.com

# Who people are told to ask about their data (an address, a name, a link).
# Shown on the "Your data" page exactly as written; left unset, the page
# says that nobody has been named yet.
# BROWNIE_SUPPORT_CONTACT=

# How many requests of each kind one signed-in person may make in a minute
# (per address when not signed in), and the largest request body read
# (a file upload has its own, larger limit). The
# defaults are far above what the web app does; they exist so that one
# account cannot exhaust the host. These are Spring properties, shown here
# with their environment spellings.
# BROWNIE_RATE_LIMIT_ENABLED=true
# BROWNIE_RATE_LIMIT_PER_MINUTE_MODEL=30
# BROWNIE_RATE_LIMIT_PER_MINUTE_RENDER=30
# BROWNIE_RATE_LIMIT_PER_MINUTE_UPLOAD=120
# BROWNIE_RATE_LIMIT_PER_MINUTE_WRITE=300
# BROWNIE_RATE_LIMIT_PER_MINUTE_READ=1200
# BROWNIE_RATE_LIMIT_PER_MINUTE_ANONYMOUS=120
# BROWNIE_WEB_MAX_BODY_BYTES=1048576

# How many isolated renders may run at once, how long another waits for its
# turn, and, optionally, the one image that may ever be run: its content
# address, as printed by `docker image inspect --format '{{.Id}}' <tag>`.
# BROWNIE_RENDER_MAX_CONCURRENT=2
# BROWNIE_RENDER_MAX_WAIT=PT20S
# BROWNIE_RENDER_EXPECTED_IMAGE_ID=
# Which image is run at all. Locally the default tag is right; a hosted
# deployment names the image it pulled, by digest, and sets the expected
# content address above so that nothing else can ever be run.
# BROWNIE_RENDER_IMAGE=brownie-spike-renderer:pinned
# Where a render's input and output directories are made. Unset is right
# whenever the API and the container runtime share a filesystem, which is the
# case when the API runs on the machine itself. When the API is itself in a
# container, this has to be a path that names the same directory inside it and
# on the host, because a mount is resolved wherever the runtime is.
# BROWNIE_RENDER_STAGING_DIR=

# brownie-worker only. Leave unset to serve. "replay-deletions" makes the
# worker apply every deletion recorded outside the database to the database
# it is pointed at, report, and end; it is the step between restoring a
# backup and starting the API. Any other value is refused at start-up.
# BROWNIE_WORKER_MODE=serve

# The clamd instance every uploaded artifact is scanned against before it
# can reach READY. Matches infra/local/compose.yaml's clamav service; not
# a secret, just a network endpoint (unlike BROWNIE_LOCAL_STORAGE_CONNECTION,
# there is nothing local-dev-only about this shape of value -- a real
# deployment points these at a real clamd the same way).
BROWNIE_CLAMAV_HOST=127.0.0.1
BROWNIE_CLAMAV_PORT=3310

# brownie-api only: the project-scoped OpenAI API key for the model
# gateway. Unlike everything above, there is no working local placeholder
# -- Docker cannot stand up a real model provider. Leave this blank and
# brownie-api will fail to start on the local profile with a clear error,
# until the owner has created the key and put the real value here. The
# model snapshot itself is not a secret and is not set here -- see
# BROWNIE_OPENAI_MODEL below for the (already-defaulted) exception.
BROWNIE_OPENAI_API_KEY=

# Optional, left unset here on purpose (a present-but-empty value would
# override the real default with an empty model name, the same
# BROWNIE_OIDC_ISSUER footgun documented above): uncomment only to test a
# specific alternative snapshot. application.yml already defaults this to
# the one evaluated baseline model, a deliberate architecture decision,
# not per-environment config.
# BROWNIE_OPENAI_MODEL=gpt-5.4-mini-2026-03-17

# Optional, local profile only: enables the e2e session-seeding route the
# Playwright suite uses instead of a real identity-provider sign-in. When
# unset (the default) that route does not exist. When set, the route also
# requires this exact value in an X-Test-Support-Token header and answers
# only loopback clients, so a stray device on the same network or a
# cross-site request cannot mint a session that would spend the real
# model key above. Any random string; keep it in your ignored .env only.
# BROWNIE_TEST_SUPPORT_TOKEN=
